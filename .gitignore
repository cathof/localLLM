# --- data (exclude all input documents) ---
data_unused/
data_unused/**

# --- artefact/output directories: keep folder in git, ignore contents ---
case_documents/*
!case_documents/.gitkeep
cases/*
!cases/.gitkeep
data/*
!data/.gitkeep
eval_results/*
!eval_results/.gitkeep
ground_truth/*
!ground_truth/.gitkeep
image_cache/*
!image_cache/.gitkeep
injection/*
!injection/.gitkeep
logs/*
!logs/.gitkeep
predictions/*
!predictions/.gitkeep
reports/*
!reports/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# --- Jupyter (falls vorhanden) ---
.ipynb_checkpoints/

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs / outputs ---
*.log
artefacts/*
!artefacts/.gitkeep
*.jsonl
.cache/
.cache/**

# --- IntelliJ / JetBrains ---
.idea/
*.iml
out/

# documents (if you don't want any docs tracked anywhere)
*.pdf
*.doc
*.docx
*.txt
!requirements.txt
*.md
*.rtf